GCP_PROJECT=slabspro-slabsuser37
GCP_REGION=asia-south1
PRIMARY_PROVIDER=gemini_api
GEMINI_MODEL_NAME=gemini-2.5-flash-lite
GEMINI_API_KEY=
# Optional backend Secret Manager reference instead of a local API key.
GEMINI_SECRET_NAME=
# Approved by the operator: only hosting/storage are pinned to asia-south1 in this mode.
ALLOW_NONREGIONAL_INFERENCE=true
# Illustrative paid-tier rates at assumed INR 90/USD; replace with your billing rates.
GEMINI_INPUT_INR=9
GEMINI_OUTPUT_INR=36
# Optional legacy Vertex settings; unused when PRIMARY_PROVIDER=gemini_api.
VERTEX_LOCATION=asia-south1
VERTEX_MODEL_NAME=gemini-3.5-flash-lite
# 2.5 Flash-Lite is selectable for compatibility but retired from Vertex on 2026-10-20.
# The lab administrator must permit the selected model in vertexai.allowedGenAIModels.
GROQ_API_KEY=
# Alternative full Secret Manager resource. The backend identity needs access to this secret.
GROQ_SECRET_NAME=
LLM_TIMEOUT_SECONDS=60
DEMO_MODE=false
AUTH_MODE=password
APP_ENV=local
SEED_SAMPLE_CASES=true
SEED_TELEMETRY=false
ENABLE_JOB_WORKER=true
TASK_BACKEND=worker
# Optional durable Cloud SQL/PostgreSQL. Keep empty for local SQLite.
DATABASE_URL=
DOCUMENTS_BUCKET=
TASKS_QUEUE=kestrel-pipeline
TASK_SERVICE_ACCOUNT=
SERVICE_URL=
SECURE_COOKIES=false
DATABASE_PATH=data/kestrel.db
DOCUMENT_DIR=data/documents
STATIC_DIR=frontend/dist
# Optional cloud identity: use AUTH_MODE=iap with verified Google IAP assertions.
IAP_AUDIENCE=
IAP_ROLE_MAP={}
# Estimated INR / million tokens, replace with contracted rates before live billing reporting.
VERTEX_INPUT_INR=44
VERTEX_OUTPUT_INR=264
GROQ_INPUT_INR=52
GROQ_OUTPUT_INR=69
